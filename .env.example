# เลือกผู้ให้บริการ: anthropic | openai | gemini | mock
LLM_PROVIDER=mock
# ถ้าไม่ใส่ จะใช้ค่า default ของแต่ละเจ้า (ดูใน src/llm/*.ts)
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ใช้ตอนรัน CLI กับ PR จริง (สิทธิ์ read-only ก็พอ ถ้าไม่โพสต์คอมเมนต์)
GITHUB_TOKEN=

# ภาษาของสรุป: th | en
SUMMARY_LANGUAGE=th
